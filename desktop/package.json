{
  "name": "filmy-desktop",
  "version": "1.0.0",
  "description": "Marcelova Filmová Databáza — desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.bucala.filmy",
    "productName": "Filmy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "players-win.js",
      {
        "from": "..",
        "to": "web",
        "filter": [
          "index.html",
          "style.css",
          "sw.js",
          "manifest.webmanifest",
          "favicon.svg",
          "icon-192.png",
          "icon-512.png",
          "apple-touch-icon.png",
          "portable-handler.js",
          "data.js",
          "data.json",
          "src/**/*.js"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../icon-512.png",
      "uninstallerIcon": "../icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "../icon-512.png",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0"
  }
}
