{
  "name": "filmy-desktop",
  "version": "1.0.0",
  "description": "Marcelova Filmová Databáza — desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.bucala.filmy",
    "productName": "Filmy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "../index.html",
      "../style.css",
      "../app.js",
      "../data.js",
      "../data.json",
      "../sw.js",
      "../manifest.webmanifest",
      "../favicon.svg",
      "../icon-192.png",
      "../icon-512.png",
      "../apple-touch-icon.png"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../icon-512.png",
      "uninstallerIcon": "../icon-512.png"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "../icon-512.png",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  }
}
